# Скопируй этот файл в .env. Не коммить .env в git.

# Какой провайдер использовать: local (LM Studio) или anthropic (облачный Claude)
AI_PROVIDER=local

# --- локальная модель (по умолчанию) ---
# Запусти LM Studio, загрузи модель и включи сервер на порту 1234.
LOCAL_AI_URL=http://localhost:1234/api/v1/chat
LOCAL_AI_MODEL=qwen/qwen3-4b-thinking-2507
# thinking-модели отвечают 8-20 секунд, таймаут в секундах
LOCAL_AI_TIMEOUT=180

# --- облачный Claude (нужен только при AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-5-20250929
